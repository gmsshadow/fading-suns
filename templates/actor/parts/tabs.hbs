<nav class="sheet-tabs tabs" data-group="primary" aria-label="{{localize 'FADINGSUNS.Tab.Primary'}}">
  {{#each tabs}}
    <a class="item {{this.cssClass}}" data-action="tab" data-group="{{this.group}}" data-tab="{{this.id}}">
      <i class="{{this.icon}}"></i><span>{{localize this.label}}</span>
    </a>
  {{/each}}
</nav>
