<div class="fading-suns occult-trigger">
  <p class="hint">
    {{#if isTaboo}}{{localize "FADINGSUNS.Occult.TabooHint"}}
    {{else}}{{localize "FADINGSUNS.Occult.DeedHint"}}{{/if}}
  </p>

  <label class="form-group">
    <span>{{shadowLabel}}</span>
    <select name="key">
      {{#each triggers as |trigger|}}
        <option value="{{trigger.key}}">{{trigger.label}} — {{trigger.roll}} ({{trigger.band}})</option>
      {{/each}}
    </select>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.Occult.Levels"}}</span>
    <input type="number" name="levels" min="1" max="3" placeholder="{{localize 'FADINGSUNS.Occult.Choose'}}"/>
  </label>
  <p class="hint">{{localize "FADINGSUNS.Hint.OccultLevels"}}</p>
</div>
