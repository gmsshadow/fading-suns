<div class="form-grid">
  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.WeaponType"}}</span>
    <select name="system.weaponType">{{selectOptions config.weaponTypes selected=system.weaponType localize=true}}</select>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.DamageDice"}}</span>
    <input type="number" name="system.damage.dice" value="{{system.damage.dice}}" min="0"/>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.DamageType"}}</span>
    <select name="system.damage.type">{{selectOptions config.damageTypes selected=system.damage.type localize=true}}</select>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.Characteristic"}}</span>
    <select name="system.characteristic">{{selectOptions config.rollableCharacteristics selected=system.characteristic localize=true}}</select>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.Skill"}}</span>
    <input type="text" name="system.skill" value="{{system.skill}}" placeholder="Melee"/>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.RateOfFire"}}</span>
    <input type="number" name="system.rateOfFire" value="{{system.rateOfFire}}" min="0"/>
  </label>
</div>

<fieldset class="range-block">
  <legend>{{localize "FADINGSUNS.Field.Range"}}</legend>
  <p class="hint">{{localize "FADINGSUNS.Hint.Range"}}</p>
  <div class="form-grid">
    <label class="form-group"><span>{{localize "FADINGSUNS.Field.RangeShort"}}</span>
      <input type="number" name="system.range.short" value="{{system.range.short}}" min="0"/></label>
    <label class="form-group"><span>{{localize "FADINGSUNS.Field.RangeMedium"}}</span>
      <input type="number" name="system.range.medium" value="{{system.range.medium}}" min="0"/></label>
    <label class="form-group"><span>{{localize "FADINGSUNS.Field.RangeLong"}}</span>
      <input type="number" name="system.range.long" value="{{system.range.long}}" min="0"/></label>
  </div>
</fieldset>

<div class="form-grid">
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.Shots"}}</span>
    <input type="number" name="system.shots.value" value="{{system.shots.value}}" min="0"/></label>
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.ShotsMax"}}</span>
    <input type="number" name="system.shots.max" value="{{system.shots.max}}" min="0"/></label>
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.TechLevel"}}</span>
    <input type="number" name="system.techLevel" value="{{system.techLevel}}" min="0" max="12"/></label>
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.Cost"}}</span>
    <input type="number" name="system.cost" value="{{system.cost}}" min="0"/></label>
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.Weight"}}</span>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"/></label>
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.Quantity"}}</span>
    <input type="number" name="system.quantity" value="{{system.quantity}}" min="0"/></label>
</div>
