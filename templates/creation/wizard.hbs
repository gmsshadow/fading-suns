<div class="wizard">

  <nav class="wizard-rail">
    {{#each steps as |s|}}
      <span class="rail-step {{#if s.current}}is-current{{/if}} {{#if s.done}}is-done{{/if}}">
        <i class="fa-solid {{#if s.done}}fa-circle-check{{else}}fa-circle{{/if}}"></i>{{s.label}}
      </span>
    {{/each}}
  </nav>

  <div class="wizard-body">

    {{#if (eq step "mode")}}
      <h3>{{localize "FADINGSUNS.Creation.Step.mode"}}</h3>
      <div class="option-cards">
        <button type="button" class="option-card {{#if (eq draft.mode "guided")}}is-selected{{/if}}"
                data-action="setMode" data-mode="guided">
          <strong>{{localize "FADINGSUNS.Creation.Guided"}}</strong>
          <span>{{localize "FADINGSUNS.Creation.GuidedHint"}}</span>
        </button>
        <button type="button" class="option-card {{#if (eq draft.mode "custom")}}is-selected{{/if}}"
                data-action="setMode" data-mode="custom">
          <strong>{{localize "FADINGSUNS.Creation.Custom"}}</strong>
          <span>{{localize "FADINGSUNS.Creation.CustomHint"}}</span>
        </button>
      </div>

      {{#if isCustom}}
        <p class="hint">{{localize "FADINGSUNS.Creation.CustomBudget"}}:
          <strong>{{customBudget.characteristics}}</strong> {{localize "FADINGSUNS.Group.Body"}} /
          <strong>{{customBudget.skills}}</strong> {{localize "FADINGSUNS.Tab.Skills"}}
          &mdash; {{localize "FADINGSUNS.Creation.Cap"}} {{cap}}</p>
      {{else}}
        <h3>{{localize "FADINGSUNS.Creation.Faction"}}</h3>
        <div class="option-cards">
          {{#each config.factions as |label key|}}
            <button type="button" class="option-card {{#if (eq key ../draft.faction)}}is-selected{{/if}}"
                    data-action="setFaction" data-faction="{{key}}">
              <strong>{{localize label}}</strong>
            </button>
          {{/each}}
        </div>
        <p class="hint">{{localize "FADINGSUNS.Creation.FactionHint"}}</p>
      {{/if}}
    {{/if}}

    {{#if stageType}}
      <h3>{{stageLabel}}</h3>
      <p class="hint">{{localize "FADINGSUNS.Stage.Budget"}}:
        <strong>{{budget.characteristics}}</strong> {{localize "FADINGSUNS.Group.Body"}} /
        <strong>{{budget.skills}}</strong> {{localize "FADINGSUNS.Tab.Skills"}}</p>

      {{#if groups.length}}
        {{#each groups as |group|}}
          {{#if group.name}}<h4 class="stage-group-heading">{{group.name}}</h4>{{/if}}
          <ol class="stage-list">
            {{#each group.stages as |stage|}}
              <li class="stage-option {{#if (eq stage.id ../../selected.id)}}is-selected{{/if}}">
                <button type="button" class="stage-pick" data-action="chooseStage"
                        data-stage-type="{{../../stageType}}" data-uuid="{{stage.uuid}}">
                  <span class="stage-name">{{stage.label}}</span>
                </button>
                <div class="stage-summary">{{{stage.system.description}}}</div>
              </li>
            {{/each}}
          </ol>
        {{/each}}
      {{else}}
        <p class="empty">{{localize "FADINGSUNS.Creation.NoStages"}}</p>
      {{/if}}

      {{#if selected}}
        <p class="chosen">{{localize "FADINGSUNS.Creation.Chosen"}}: <strong>{{selected.name}}</strong>
          <button type="button" class="icon-btn" data-action="clearStage" data-stage-type="{{stageType}}"
                  data-tooltip="{{localize 'FADINGSUNS.Creation.Clear'}}"><i class="fa-solid fa-xmark"></i></button>
        </p>
      {{/if}}
    {{/if}}

    {{#if (eq step "choices")}}
      <h3>{{localize "FADINGSUNS.Creation.Step.choices"}}</h3>
      {{#if choices.length}}
        <p class="hint">{{localize "FADINGSUNS.Creation.ChoicesHint"}}</p>
        <ol class="choice-list">
          {{#each choices as |entry|}}
            <li class="choice {{#if entry.complete}}is-complete{{/if}}"
                data-choice-group="{{entry.choice.id}}" data-pick="{{entry.pick}}"
                {{#if entry.isOpen}}data-pool="{{entry.choice.pool}}"{{/if}}>
              <span class="choice-stage">{{entry.stage}}</span>
              <span class="choice-label">{{entry.choice.label}}</span>

              {{#if entry.isOpen}}
                <select class="pool-select" data-choice-id="{{entry.choice.id}}"
                        data-pool="{{entry.choice.pool}}" data-pick="1">
                  <option value="">{{localize "FADINGSUNS.Creation.PickOne"}}</option>
                  {{#each entry.poolOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                  {{/each}}
                </select>
              {{else}}
                {{#if (gt entry.pick 1)}}
                  <span class="choice-count">0 / {{entry.pick}}</span>
                {{/if}}
                <div class="choice-options">
                  {{#each entry.options as |option|}}
                    <label class="choice-option">
                      {{#if (gt entry.pick 1)}}
                        <input type="checkbox" value="{{option.index}}"
                               data-choice-id="{{entry.choice.id}}" data-pick="{{entry.pick}}"
                               {{checked option.checked}}/>
                      {{else}}
                        <input type="radio" name="choice-{{entry.choice.id}}" value="{{option.index}}"
                               data-choice-id="{{entry.choice.id}}" data-pick="1"
                               {{checked option.checked}}/>
                      {{/if}}
                      <span>{{option.label}}</span>
                    </label>
                  {{/each}}
                </div>
              {{/if}}
            </li>
          {{/each}}
        </ol>
      {{else}}
        <p class="empty">{{localize "FADINGSUNS.Creation.NoChoices"}}</p>
      {{/if}}
    {{/if}}

    {{#if (eq step "benefices")}}
      <h3>{{localize "FADINGSUNS.Creation.Step.benefices"}}</h3>
      <p class="budget {{#if beneficeOver}}is-over{{/if}}">
        {{localize "FADINGSUNS.Benefice.Points"}}:
        <strong>{{beneficeSpent}} / {{beneficeBudget}}</strong>
      </p>
      <p class="hint">{{localize "FADINGSUNS.Hint.BeneficePoints"}}</p>

      <div class="picker-row">
        <select name="beneficePick">
          <option value="">{{localize "FADINGSUNS.Creation.PickOne"}}</option>
          {{#each beneficeGroups as |group|}}
            <optgroup label="{{group.label}}">
              {{#each group.entries as |entry|}}
                <option value="{{entry.uuid}}">{{entry.name}} ({{entry.value}})</option>
              {{/each}}
            </optgroup>
          {{/each}}
        </select>
        <input type="number" name="beneficeRank" min="0" placeholder="{{localize 'FADINGSUNS.Benefice.Value'}}"/>
        <button type="button" class="add-btn" data-action="addBenefice">
          <i class="fa-solid fa-plus"></i> {{localize "FADINGSUNS.Control.Add"}}
        </button>
      </div>

      <ol class="chosen-list">
        {{#each chosenBenefices as |entry index|}}
          <li class="{{#if (eq entry.polarity "affliction")}}is-curse{{/if}}">
            <span class="chosen-name">{{entry.name}}</span>
            <span class="chosen-value">{{entry.value}}</span>
            <button type="button" class="icon-btn danger" data-action="removeBenefice" data-index="{{index}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </li>
        {{else}}
          <li class="empty">{{localize "FADINGSUNS.Creation.NoBenefices"}}</li>
        {{/each}}
      </ol>
    {{/if}}

    {{#if (eq step "extras")}}
      <h3>{{localize "FADINGSUNS.Creation.Step.extras"}}</h3>
      <p class="budget {{#if extraOver}}is-over{{/if}}">
        {{localize "FADINGSUNS.Creation.ExtraPoints"}}:
        <strong>{{extraSpent}} / {{extraBudget}}</strong>
        <span class="hint">
          {{#if extraFromCurses}}+{{extraFromCurses}} {{localize "FADINGSUNS.Blessing.Curse"}}{{/if}}
          {{#if extraFromAfflictions}}+{{extraFromAfflictions}} {{localize "FADINGSUNS.Benefice.Affliction"}}{{/if}}
        </span>
      </p>
      <p class="hint">{{localize "FADINGSUNS.Hint.ExtraPoints"}}</p>

      <div class="picker-row">
        <select name="extra-characteristic">
          {{#each characteristicOptions as |option|}}
            <option value="{{option.value}}">{{option.label}}</option>
          {{/each}}
        </select>
        <button type="button" class="add-btn" data-action="buyExtra" data-kind="characteristic">
          +1 ({{extraCosts.characteristic}})
        </button>
      </div>

      <div class="picker-row">
        <select name="extra-skill">
          {{#each skillOptions as |option|}}
            <option value="{{option.value}}">{{option.label}}</option>
          {{/each}}
        </select>
        <button type="button" class="add-btn" data-action="buyExtra" data-kind="skill">
          +1 ({{extraCosts.skill}})
        </button>
      </div>

      <div class="picker-row">
        <select name="extra-blessing">
          {{#each blessingOptions as |option|}}
            <option value="{{option.value}}">{{option.label}}</option>
          {{/each}}
        </select>
        <button type="button" class="add-btn" data-action="buyExtra" data-kind="blessing">
          {{localize "FADINGSUNS.Control.Add"}}
        </button>
      </div>

      <div class="picker-row">
        <select name="extra-combat-action">
          {{#each combatActionOptions as |option|}}
            <option value="{{option.value}}">{{option.label}}</option>
          {{/each}}
        </select>
        <button type="button" class="add-btn" data-action="buyExtra" data-kind="combatAction">
          {{localize "FADINGSUNS.Control.Add"}}
        </button>
      </div>

      <div class="picker-row">
        <span class="picker-label">{{localize "FADINGSUNS.Wyrd"}}</span>
        <button type="button" class="add-btn" data-action="buyExtra" data-kind="wyrd">
          +1 ({{extraCosts.wyrd}})
        </button>
      </div>

      <ol class="chosen-list">
        {{#each purchases as |row|}}
          <li>
            <span class="chosen-name">{{row.label}}</span>
            {{#if (gt row.levels 1)}}<span class="chosen-levels">&times;{{row.levels}}</span>{{/if}}
            <span class="chosen-value">{{row.cost}}</span>
            <button type="button" class="icon-btn danger" data-action="removeExtra"
                    data-kind="{{row.kind}}" data-key="{{row.key}}">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </li>
        {{else}}
          <li class="empty">{{localize "FADINGSUNS.Creation.NoExtras"}}</li>
        {{/each}}
      </ol>
    {{/if}}

    {{#if (eq step "review")}}
      <h3>{{localize "FADINGSUNS.Creation.Step.review"}}</h3>

      {{#if isCustom}}
        <p class="hint">{{localize "FADINGSUNS.Creation.CustomReview"}}</p>
      {{/if}}
      {{#unless isCustom}}
        {{#if review.overages.length}}
          <p class="warning"><i class="fa-solid fa-triangle-exclamation"></i>
            {{localize "FADINGSUNS.Creation.OverCap"}}
            <strong>{{review.freed}}</strong> {{localize "FADINGSUNS.Creation.FreedPoints"}}</p>
        {{/if}}
        {{#if review.sparePoints}}
          <p class="hint">{{localize "FADINGSUNS.Creation.SparePoints"}}: <strong>{{review.sparePoints}}</strong></p>
        {{/if}}

        <div class="review-columns">
          <div>
            <h4>{{localize "FADINGSUNS.Tab.Characteristics"}}</h4>
            <ol class="review-list">
              {{#each review.characteristics as |c|}}
                <li class="{{#if c.overCap}}is-over{{/if}}">
                  <span>{{c.label}}{{#if c.primary}} <i class="fa-solid fa-star"></i>{{/if}}</span>
                  <strong>{{c.value}}</strong>
                </li>
              {{/each}}
            </ol>
          </div>
          <div>
            <h4>{{localize "FADINGSUNS.Tab.Skills"}}</h4>
            <ol class="review-list">
              {{#each review.skills as |s|}}
                <li class="{{#if s.overCap}}is-over{{/if}}"><span>{{s.label}}</span><strong>{{s.value}}</strong></li>
              {{/each}}
            </ol>
          </div>
        </div>

        <p class="hint">
          {{localize "FADINGSUNS.Section.BlessingsCurses"}}: <strong>{{review.traitCount}}</strong> &mdash;
          {{localize "FADINGSUNS.Section.BeneficesAfflictions"}}: <strong>{{review.beneficeCount}}</strong>
        </p>

        {{#if review.notes.length}}
          <h4>{{localize "FADINGSUNS.Creation.Notes"}}</h4>
          <ul class="review-notes">{{#each review.notes as |n|}}<li>{{n}}</li>{{/each}}</ul>
        {{/if}}
      {{/unless}}
    {{/if}}

  </div>

  <footer class="wizard-footer">
    {{#if canGoBack}}
      <button type="button" class="add-btn" data-action="back">
        <i class="fa-solid fa-arrow-left"></i> {{localize "FADINGSUNS.Creation.Back"}}
      </button>
    {{/if}}
    <span class="spacer"></span>
    {{#if (eq step "review")}}
      <button type="button" class="add-btn primary" data-action="apply">
        <i class="fa-solid fa-check"></i> {{localize "FADINGSUNS.Creation.Apply"}}
      </button>
    {{else}}
      <button type="button" class="add-btn primary" data-action="next">
        {{localize "FADINGSUNS.Creation.Next"}} <i class="fa-solid fa-arrow-right"></i>
      </button>
    {{/if}}
  </footer>

</div>
