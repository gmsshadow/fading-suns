<div class="form-grid">
  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.ProtectionDice"}}</span>
    <input type="number" name="system.protection.dice" value="{{system.protection.dice}}" min="0"/>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.Coverage"}}</span>
    <select name="system.coverage">{{selectOptions config.armourCoverage selected=system.coverage localize=true}}</select>
  </label>

  <label class="form-group">
    <span>{{localize "FADINGSUNS.ArmourType.Label"}}</span>
    <select name="system.armourType">{{selectOptions config.armourTypes selected=system.armourType localize=true}}</select>
  </label>

  <label class="form-group"><span>{{localize "FADINGSUNS.Field.TechLevel"}}</span>
    <input type="number" name="system.techLevel" value="{{system.techLevel}}" min="0" max="12"/></label>
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.Cost"}}</span>
    <input type="number" name="system.cost" value="{{system.cost}}" min="0"/></label>
  <label class="form-group"><span>{{localize "FADINGSUNS.Field.Weight"}}</span>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1"/></label>
</div>
<fieldset>
  <legend>{{localize "FADINGSUNS.Field.Penalty"}}</legend>
  <div class="form-grid">
    <label class="form-group"><span>{{localize "FADINGSUNS.Characteristic.Strength"}}</span>
      <input type="number" name="system.penalties.strength" value="{{system.penalties.strength}}"/></label>
    <label class="form-group"><span>{{localize "FADINGSUNS.Characteristic.Dexterity"}}</span>
      <input type="number" name="system.penalties.dexterity" value="{{system.penalties.dexterity}}"/></label>
    <label class="form-group"><span>{{localize "FADINGSUNS.Field.VigorPenalty"}}</span>
      <input type="number" name="system.penalties.vigor" value="{{system.penalties.vigor}}"/></label>
  </div>
  <label class="form-group checkbox">
    <input type="checkbox" name="system.energyShieldCompatible" {{checked system.energyShieldCompatible}}/>
    <span>{{localize "FADINGSUNS.Field.EnergyShieldCompatible"}}</span>
  </label>
</fieldset>

{{#if (eq system.armourType "shield")}}
  <label class="form-group">
    <span>{{localize "FADINGSUNS.Field.ShieldDamage"}}</span>
    <input type="number" name="system.shieldDamage" value="{{system.shieldDamage}}" min="0"/>
  </label>
{{/if}}

{{#if (eq system.armourType "energyShield")}}
  <fieldset>
    <legend>{{localize "FADINGSUNS.ArmourType.EnergyShield"}}</legend>
    <div class="form-grid">
      <label class="form-group"><span>{{localize "FADINGSUNS.Field.ShieldMin"}}</span>
        <input type="number" name="system.energyShield.min" value="{{system.energyShield.min}}" min="0"/></label>
      <label class="form-group"><span>{{localize "FADINGSUNS.Field.ShieldMax"}}</span>
        <input type="number" name="system.energyShield.max" value="{{system.energyShield.max}}" min="0"/></label>
      <label class="form-group"><span>{{localize "FADINGSUNS.Field.ShieldHits"}}</span>
        <input type="number" name="system.energyShield.hits.value" value="{{system.energyShield.hits.value}}" min="0"/></label>
      <label class="form-group"><span>{{localize "FADINGSUNS.Field.ShieldHitsMax"}}</span>
        <input type="number" name="system.energyShield.hits.max" value="{{system.energyShield.hits.max}}" min="0"/></label>
    </div>
  </fieldset>
{{/if}}

<p class="hint">{{localize "FADINGSUNS.Hint.Armour"}}</p>
