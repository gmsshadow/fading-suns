<section class="tab description {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#if editable}}
    <prose-mirror name="system.description" value="{{system.description}}"
                  toggled="true" button="true" editable="true">{{{enrichedDescription}}}</prose-mirror>
  {{else}}
    <div class="editor-content">{{{enrichedDescription}}}</div>
  {{/if}}
</section>
