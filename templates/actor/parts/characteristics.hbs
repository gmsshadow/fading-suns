<section class="tab characteristics {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="characteristic-block">
    <h3>{{localize "FADINGSUNS.Group.Body"}}</h3>
    <div class="characteristic-grid">
      {{#each characteristics.body as |char|}}
        <div class="characteristic">
          <span class="char-name">{{char.label}}</span>
          <input type="number" name="system.{{char.path}}.value" value="{{char.value}}" min="0"
                 max="{{char.max}}" class="{{#if char.overCap}}is-over{{/if}}"
                 data-tooltip="{{localize 'FADINGSUNS.Race.Maximum'}} {{char.max}}"/>
          <button type="button" class="roll-btn" data-action="roll" data-characteristic="{{char.path}}"
                  data-tooltip="{{localize 'FADINGSUNS.Roll.Tooltip'}}">
            <i class="fa-solid fa-dice-d20"></i>
          </button>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="characteristic-block">
    <h3>{{localize "FADINGSUNS.Group.Mind"}}</h3>
    <div class="characteristic-grid">
      {{#each characteristics.mind as |char|}}
        <div class="characteristic">
          <span class="char-name">{{char.label}}</span>
          <input type="number" name="system.{{char.path}}.value" value="{{char.value}}" min="0"
                 max="{{char.max}}" class="{{#if char.overCap}}is-over{{/if}}"
                 data-tooltip="{{localize 'FADINGSUNS.Race.Maximum'}} {{char.max}}"/>
          <button type="button" class="roll-btn" data-action="roll" data-characteristic="{{char.path}}"
                  data-tooltip="{{localize 'FADINGSUNS.Roll.Tooltip'}}">
            <i class="fa-solid fa-dice-d20"></i>
          </button>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="characteristic-block spirit">
    <h3>{{localize "FADINGSUNS.Group.Spirit"}}</h3>
    <p class="hint">{{localize "FADINGSUNS.Hint.SpiritPairs"}}</p>
    {{#each spiritPairs as |pair|}}
      <div class="spirit-pair">
        <div class="characteristic {{#if pair.primary.isPrimary}}is-primary{{/if}}">
          <span class="char-name">{{pair.primary.label}}</span>
          <input type="number" name="system.{{pair.primary.path}}.value" value="{{pair.primary.value}}" min="0"
                 max="{{pair.primary.max}}" class="{{#if pair.primary.overCap}}is-over{{/if}}"/>
          <label class="primary-toggle" data-tooltip="{{localize 'FADINGSUNS.Hint.Primary'}}">
            <input type="checkbox" name="system.{{pair.primary.path}}.primary" {{checked pair.primary.isPrimary}}/>
          </label>
          <button type="button" class="roll-btn" data-action="roll" data-characteristic="{{pair.primary.path}}">
            <i class="fa-solid fa-dice-d20"></i>
          </button>
        </div>

        <span class="versus">{{localize "FADINGSUNS.Versus"}}</span>

        <div class="characteristic {{#if pair.opposed.isPrimary}}is-primary{{/if}}">
          <span class="char-name">{{pair.opposed.label}}</span>
          <input type="number" name="system.{{pair.opposed.path}}.value" value="{{pair.opposed.value}}" min="0"
                 max="{{pair.opposed.max}}" class="{{#if pair.opposed.overCap}}is-over{{/if}}"/>
          <label class="primary-toggle" data-tooltip="{{localize 'FADINGSUNS.Hint.Primary'}}">
            <input type="checkbox" name="system.{{pair.opposed.path}}.primary" {{checked pair.opposed.isPrimary}}/>
          </label>
          <button type="button" class="roll-btn" data-action="roll" data-characteristic="{{pair.opposed.path}}">
            <i class="fa-solid fa-dice-d20"></i>
          </button>
        </div>
      </div>
    {{/each}}
  </div>

  <div class="characteristic-block">
    <h3>{{localize "FADINGSUNS.Group.Occult"}}</h3>
    <div class="characteristic-grid">
      {{#each characteristics.occult as |char|}}
        <div class="characteristic">
          <span class="char-name">{{char.label}}</span>
          <input type="number" name="system.{{char.path}}.value" value="{{char.value}}" min="0"
                 max="{{char.max}}" class="{{#if char.overCap}}is-over{{/if}}"
                 data-tooltip="{{localize 'FADINGSUNS.Race.Maximum'}} {{char.max}}"/>
        </div>
      {{/each}}
    </div>
  </div>


  <div class="items-section blessings">
    <header class="items-header">
      <h3>{{localize "FADINGSUNS.Section.BlessingsCurses"}}</h3>
      <button type="button" class="add-btn" data-action="itemCreate" data-type="blessing">
        <i class="fa-solid fa-plus"></i> {{localize "FADINGSUNS.Control.Add"}}
      </button>
    </header>
    <ol class="items-list">
      {{#each items.blessing as |trait|}}
        <li class="item draggable {{#if trait.system.isCurse}}is-curse{{/if}}" data-item-id="{{trait.id}}">
          <img class="item-img" src="{{trait.img}}" alt="{{trait.name}}"/>
          <span class="item-name">{{trait.name}}</span>
          <span class="item-tag">{{trait.system.summary}}</span>
          <span class="item-restriction">{{trait.system.restriction}}</span>
          <button type="button" class="icon-btn" data-action="itemEdit"
                  data-tooltip="{{localize 'FADINGSUNS.Control.Edit'}}"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="icon-btn danger" data-action="itemDelete"
                  data-tooltip="{{localize 'FADINGSUNS.Control.Delete'}}"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}
        <li class="empty">{{localize "FADINGSUNS.Empty.BlessingsCurses"}}</li>
      {{/each}}
    </ol>
    <p class="hint">{{localize "FADINGSUNS.Hint.BlessingLimit"}}</p>
  </div>

  <div class="items-section benefices">
    <header class="items-header">
      <h3>{{localize "FADINGSUNS.Section.BeneficesAfflictions"}}</h3>
      <span class="point-total {{#if (lt benefices.remaining 0)}}is-over{{/if}}">
        {{benefices.spent}} / {{benefices.budget}} {{localize "FADINGSUNS.Benefice.Points"}}
      </span>
      <button type="button" class="add-btn" data-action="itemCreate" data-type="benefice">
        <i class="fa-solid fa-plus"></i> {{localize "FADINGSUNS.Control.Add"}}
      </button>
    </header>
    <ol class="items-list">
      {{#each items.benefice as |entry|}}
        <li class="item draggable {{#if entry.system.isAffliction}}is-curse{{/if}}" data-item-id="{{entry.id}}">
          <img class="item-img" src="{{entry.img}}" alt="{{entry.name}}"/>
          <span class="item-name">{{entry.name}}</span>
          <input class="item-value" type="number" value="{{entry.system.value}}"
                 data-item-field="system.value" data-dtype="Number" min="0"
                 data-tooltip="{{localize 'FADINGSUNS.Benefice.Value'}}"/>
          <span class="item-restriction">{{entry.system.summary}}</span>
          <button type="button" class="icon-btn" data-action="itemEdit"
                  data-tooltip="{{localize 'FADINGSUNS.Control.Edit'}}"><i class="fa-solid fa-pen-to-square"></i></button>
          <button type="button" class="icon-btn danger" data-action="itemDelete"
                  data-tooltip="{{localize 'FADINGSUNS.Control.Delete'}}"><i class="fa-solid fa-trash"></i></button>
        </li>
      {{else}}
        <li class="empty">{{localize "FADINGSUNS.Empty.BeneficesAfflictions"}}</li>
      {{/each}}
    </ol>
    {{#if benefices.firebirds}}
      <p class="hint">{{localize "FADINGSUNS.Benefice.Firebirds"}}: <strong>{{benefices.firebirds}}</strong>{{#if benefices.income}} &mdash; {{localize "FADINGSUNS.Benefice.Income"}}: <strong>{{benefices.income}}</strong>{{/if}}</p>
    {{/if}}
    {{#if benefices.extras}}
      <p class="hint">{{localize "FADINGSUNS.Benefice.Extras"}}: <strong>{{benefices.extras}}</strong></p>
    {{/if}}
    <p class="hint">{{localize "FADINGSUNS.Hint.BeneficePoints"}}</p>
  </div>

</section>
